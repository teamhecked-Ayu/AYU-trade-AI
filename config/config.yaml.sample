exchanges:
  binance:
    enabled: true
    symbols: [BTC/USDT, ETH/USDT, SOL/USDT]
  kraken:
    enabled: false
    symbols: [BTC/USD, ETH/USD]

strategies:
  sentiment:
    enabled: true
    sources: [twitter, reddit, cryptopanic]
    weight: 0.3
  technical:
    enabled: true
    indicators: [RSI, MACD, Bollinger]
    weight: 0.4
  arbitrage:
    enabled: true
    threshold: 0.005
    weight: 0.3

risk_management:
  max_position_size: 0.1
  stop_loss: 0.02
  take_profit: 0.05
  daily_loss_limit: 0.05
  kelly_criterion: true

performance:
  latency_threshold_ms: 50
  websocket_retry_interval: 5

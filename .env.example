# Runtime configuration. Never commit a real .env file.
PAPER_TRADE=true
LOG_LEVEL=INFO

# Required for protected portfolio and order endpoints.
AYU_API_KEY=replace_with_a_long_random_secret
PAPER_PORTFOLIO_DB=data/paper_portfolio.db

# AYUAI authentication and encryption secrets. Use separate random values.
AYUAI_AUTH_SECRET=replace_with_a_long_random_auth_secret
AYUAI_KEY_VAULT_SECRET=replace_with_a_long_random_vault_secret

# AYUAI server-only AI provider keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=

# Browser origins allowed to call the API. Add the exact deployed frontend origin.
AYUAI_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Multi-service infrastructure
DATABASE_URL=postgresql+asyncpg://ayuai:change-me-in-production@localhost:5432/ayuai
REDIS_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=change-me-in-production

# Optional exchange and broker keys
BINANCE_API_KEY=
BINANCE_API_SECRET=
KITE_API_KEY=
KITE_ACCESS_TOKEN=
